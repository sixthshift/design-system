{
  "name": "@sixthshift/design-system",
  "version": "0.1.0",
  "description": "Personal design system - tokens, theme, and component library",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixthshift/design-system.git"
  },
  "homepage": "https://github.com/sixthshift/design-system#readme",
  "bugs": {
    "url": "https://github.com/sixthshift/design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "component-library",
    "tailwindcss",
    "design-tokens",
    "temporal"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "dist",
    "tailwind.config.ts",
    "CHANGELOG.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__screenshots__",
    "!src/**/*.stories.tsx",
    "!src/stories",
    "!src/testing"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.generated.css",
    "./theme": "./src/theme/index.ts",
    "./tailwind.config": "./tailwind.config.ts",
    "./utils": "./src/lib/utils.ts",
    "./format": "./src/lib/format.ts",
    "./hooks": "./src/hooks/index.ts",
    "./date-time": "./src/date-time/index.ts",
    "./button": "./src/components/Button/index.ts",
    "./input": "./src/components/Input/index.ts",
    "./textarea": "./src/components/Textarea/index.ts",
    "./checkbox": "./src/components/Checkbox/index.ts",
    "./checkbox-group": "./src/components/CheckboxGroup/index.ts",
    "./radio-button": "./src/components/RadioButton/index.ts",
    "./radio-button-group": "./src/components/RadioButtonGroup/index.ts",
    "./switch": "./src/components/Switch/index.ts",
    "./toggle": "./src/components/Toggle/index.ts",
    "./toggle-group": "./src/components/ToggleGroup/index.ts",
    "./badge": "./src/components/Badge/index.ts",
    "./color-dot": "./src/components/ColorDot/index.ts",
    "./tag-chip": "./src/components/TagChip/index.ts",
    "./tag-input": "./src/components/TagInput/index.ts",
    "./field": "./src/components/Field/index.ts",
    "./breadcrumb": "./src/components/Breadcrumb/index.ts",
    "./card": "./src/components/Card/index.ts",
    "./avatar": "./src/components/Avatar/index.ts",
    "./separator": "./src/components/Separator/index.ts",
    "./skeleton": "./src/components/Skeleton/index.ts",
    "./spinner": "./src/components/Spinner/index.ts",
    "./stats-card": "./src/components/StatsCard/index.ts",
    "./metric-list": "./src/components/MetricList/index.ts",
    "./empty-state": "./src/components/EmptyState/index.ts",
    "./text": "./src/components/Text/index.ts",
    "./text-inline": "./src/components/TextInline/index.ts",
    "./calendar": "./src/components/Calendar/index.ts",
    "./modal": "./src/components/Modal/index.ts",
    "./sheet": "./src/components/Sheet/index.ts",
    "./toast": "./src/components/Toast/index.ts",
    "./message": "./src/components/Message/index.ts",
    "./select": "./src/components/Select/index.ts",
    "./form-field": "./src/components/FormField/index.ts",
    "./popover": "./src/components/Popover/index.ts",
    "./hover-card": "./src/components/HoverCard/index.ts",
    "./date-picker": "./src/components/DatePicker/index.ts",
    "./time-picker": "./src/components/TimePicker/index.ts",
    "./datetime-picker": "./src/components/DateTimePicker/index.ts",
    "./datetime-range-picker": "./src/components/DateTimeRangePicker/index.ts",
    "./tooltip": "./src/components/Tooltip/index.ts",
    "./tabs": "./src/components/Tabs/index.ts",
    "./search-input": "./src/components/SearchInput/index.ts",
    "./pagination": "./src/components/Pagination/index.ts",
    "./code-editor": "./src/components/Code/Editor/index.ts",
    "./code-editor-workspace": "./src/components/Code/Workspace/index.ts",
    "./nav-side": "./src/components/NavSide/index.ts",
    "./nav-bottom": "./src/components/NavBottom/index.ts",
    "./heading": "./src/typography/Heading.tsx",
    "./label": "./src/typography/Label.tsx",
    "./section-title": "./src/typography/SectionTitle.tsx",
    "./caption": "./src/typography/Caption.tsx",
    "./code": "./src/typography/Code.tsx",
    "./lead": "./src/typography/Lead.tsx",
    "./body": "./src/typography/Body.tsx",
    "./muted": "./src/typography/Muted.tsx",
    "./display": "./src/typography/Display.tsx",
    "./emphasis": "./src/typography/Emphasis.tsx",
    "./mono": "./src/typography/Mono.tsx",
    "./subtitle": "./src/typography/Subtitle.tsx",
    "./timestamp": "./src/typography/Timestamp.tsx",
    "./overlay": "./src/lib/contexts/OverlayContext/index.ts",
    "./components": "./src/lib/contexts/ComponentsContext/index.ts",
    "./error-boundary": "./src/lib/ErrorBoundary.tsx",
    "./with-suspense": "./src/lib/withSuspense.tsx",
    "./with-error-boundary": "./src/lib/withErrorBoundary.tsx",
    "./with-suspense-and-error-boundary": "./src/lib/withSuspenseAndErrorBoundary.tsx",
    "./with-empty": "./src/lib/withEmpty.tsx",
    "./empty-boundary": "./src/lib/EmptyBoundary.tsx",
    "./progress-bar": "./src/components/ProgressBar/index.ts",
    "./markdown": "./src/components/Markdown/index.ts",
    "./line-chart": "./src/components/LineChart/index.ts",
    "./sparkline": "./src/components/Sparkline/index.ts",
    "./bar-chart": "./src/components/BarChart/index.ts",
    "./heat-map": "./src/components/HeatMap/index.ts"
  },
  "scripts": {
    "prepare": "bun run build",
    "build": "bun run build:theme && bun run build:css",
    "build:theme": "bun run scripts/generate-theme.ts -i src/theme/theme.json -p src/theme/palette.json -t src/theme/typography.json -o dist/theme.generated.css",
    "build:css": "tailwindcss -i src/styles/base.css -o dist/styles.css --minify",
    "dev": "bun run dev:css & bun run dev:theme",
    "dev:css": "tailwindcss -i src/styles/base.css -o dist/styles.css --watch",
    "dev:theme": "bun run scripts/watch-theme.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit --project date-time --reporter=dot",
    "test:verbose": "vitest run --project unit --project date-time",
    "test:watch": "vitest --project unit --project date-time",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "test:stories": "vitest run --project storybook",
    "test:ui": "bunx vitest --ui",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@js-temporal/polyfill": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-themes": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.8",
    "@storybook/react": "^10.1.8",
    "@storybook/react-vite": "^10.1.8",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "commander": "^14.0.2",
    "happy-dom": "^20.9.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "storybook": "^10.1.8",
    "tailwindcss": "^4",
    "typescript": "~5.7.2",
    "vite": "^6.4.1",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "peerDependenciesMeta": {
    "@fontsource-variable/inter": {
      "optional": true
    },
    "@fontsource-variable/jetbrains-mono": {
      "optional": true
    },
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "vitest": "4.1.7",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/expect": "4.1.7",
    "@vitest/mocker": "4.1.7",
    "@vitest/pretty-format": "4.1.7",
    "@vitest/runner": "4.1.7",
    "@vitest/snapshot": "4.1.7",
    "@vitest/spy": "4.1.7",
    "@vitest/ui": "4.1.7",
    "@vitest/utils": "4.1.7"
  }
}
