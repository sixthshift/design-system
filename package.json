{
  "name": "@sixthshift/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal design system - tokens, theme, and component library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@sixthshift/ui' dev",
    "storybook": "bun run --filter='@sixthshift/ui' storybook",
    "build": "bun run --filter='@sixthshift/*' build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun --filter='*' run test",
    "test:verbose": "bun --filter='*' run test:verbose",
    "test:ui": "bunx vitest --ui",
    "type-check": "tsc -b && bun run --filter='@sixthshift/*' type-check",
    "clean": "bun run --filter='@sixthshift/*' clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "@vitest/ui": "4.1.7",
    "playwright": "^1.57.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "overrides": {
    "vitest": "4.1.7",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/expect": "4.1.7",
    "@vitest/mocker": "4.1.7",
    "@vitest/pretty-format": "4.1.7",
    "@vitest/runner": "4.1.7",
    "@vitest/snapshot": "4.1.7",
    "@vitest/spy": "4.1.7",
    "@vitest/ui": "4.1.7",
    "@vitest/utils": "4.1.7"
  }
}
