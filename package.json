  "scripts": {
    "prepare": "bun run build",
    "build": "bun run clean:dist && bun run scripts/check-use-client.ts && bun run build:js && bun run scripts/check-exports.ts",
    "build:js": "tsc -p tsconfig.build.json && bun run scripts/fix-extensions.ts",
    "dev": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test": "vitest run --project unit --project date-time --project ssr --reporter=dot",
    "test:coverage": "vitest run --project unit --project date-time --project ssr --coverage --reporter=dot",
    "test:verbose": "vitest run --project unit --project date-time --project ssr",
    "test:watch": "vitest --project unit --project date-time --project ssr",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "test:stories": "vitest run --project storybook --project storybook-dark",
    "test:stories:dark": "vitest run --project storybook-dark",
    "test:ui": "bunx vitest --ui",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:recipes": "bun run scripts/check-recipes.ts",
    "check:contrast": "bun run scripts/check-contrast.ts",
    "check:api": "bun run scripts/api-snapshot.ts --check",
    "check:size": "bun run scripts/check-size.ts",
    "api:update": "bun run scripts/api-snapshot.ts",
    "check:published": "bun run scripts/check-published.ts",
    "check:consumer-resolution": "bun run scripts/check-consumer-resolution.ts",
    "check:use-client": "bun run scripts/check-use-client.ts",
    "clean:artifacts": "rm -rf coverage .vitest-attachments",
    "clean": "rm -rf dist node_modules *.tsbuildinfo",
    "clean:dist": "rm -rf dist"
  },
