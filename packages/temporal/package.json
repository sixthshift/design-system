{
  "name": "@sixthshift/temporal",
  "version": "0.1.0",
  "private": true,
  "description": "Date/time utilities using Temporal API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --reporter=dot",
    "test:verbose": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.0"
  },
  "devDependencies": {
    "vitest": "4.1.7"
  }
}
