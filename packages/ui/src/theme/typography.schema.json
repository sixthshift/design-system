{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PA Typography",
  "description": "Typography definition for Personal Assistant",
  "type": "object",
  "required": ["fonts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fonts": {
      "type": "object",
      "description": "Font family definitions",
      "properties": {
        "sans": {
          "type": "string",
          "description": "Sans-serif font stack for body text and UI"
        },
        "mono": {
          "type": "string",
          "description": "Monospace font stack for code and technical content"
        },
        "serif": {
          "type": "string",
          "description": "Serif font stack for headings or special content"
        }
      },
      "required": ["sans", "mono"],
      "additionalProperties": {
        "type": "string",
        "description": "Additional font family definition"
      }
    }
  },
  "additionalProperties": false
}
