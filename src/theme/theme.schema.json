{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PA Theme",
  "description": "Color theme definition for Personal Assistant",
  "type": "object",
  "required": ["name", "version", "light", "dark"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Theme name"
    },
    "version": {
      "type": "string",
      "description": "Theme version (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "light": {
      "$ref": "#/$defs/colorMode",
      "description": "Light mode colors"
    },
    "dark": {
      "$ref": "#/$defs/colorMode",
      "description": "Dark mode colors"
    }
  },
  "$defs": {
    "colorValue": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|var\\(--color-[a-z]+-\\d+\\)|white|black|rgba\\(\\d+,\\s*\\d+,\\s*\\d+,\\s*[\\d.]+\\))$",
      "description": "Hex color (#818cf8), CSS variable (var(--color-ocean-700)), keyword (white, black), or rgba()"
    },
